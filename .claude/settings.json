{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet --version)",
      "Bash(py Design/ArteFonte/Ferramentas/:*)",
      "Bash(py .claude/skills/:*)",
      "Bash(py .claude/hooks/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git lfs ls-files:*)"
    ],
    "deny": [
      "Read(Desenvolvimento/Library/**)",
      "Read(Desenvolvimento/Temp/**)",
      "Read(Desenvolvimento/Logs/**)",
      "Read(Desenvolvimento/.vs/**)"
    ]
  },
  "enabledPlugins": {
    "unity@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "aseprite",
    "unity"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_snapshot.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_generated_dirs.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/build_game_core.py\"",
            "timeout": 60,
            "statusMessage": "dotnet build Braziliation.Game.Core..."
          }
        ]
      }
    ]
  }
}
