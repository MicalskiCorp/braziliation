# JID da conversa dedicada de entrevistas.
# Numero pessoal: 5547999999999@s.whatsapp.net (DDI+DDD+numero, sem sinais)
# Grupo: termina em @g.us
#
# Deixe em branco na primeira vez: o listener entra em modo descoberta e
# imprime o JID de cada mensagem recebida, sem salvar nada. Copie o JID
# certo para ca depois de mandar uma mensagem de teste na conversa.
WHATSAPP_CHAT_JID=

# Pastas (padrao se vazio: auth/ e ../../_inbox, relativos a este arquivo)
AUTH_DIR=
INBOX_DIR=

# Aviso de volta na conversa quando a captura pega, para dar para conferir no celular:
#   mensagem (padrao) = manda "✅ Documento recebido: x.pdf (1,2 MB) — na fila de curadoria"
#   reacao            = so reage com ✅ na mensagem original (discreto, nao polui o grupo)
#   off               = nao avisa nada
CONFIRMAR_CAPTURA=mensagem

# trace/debug/info/warn/error/silent
LOG_LEVEL=warn
