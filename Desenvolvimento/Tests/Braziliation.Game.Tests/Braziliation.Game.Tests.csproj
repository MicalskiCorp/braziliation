<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Braziliation.Game.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Braziliation.Game.Core\Braziliation.Game.Core.csproj" />
  </ItemGroup>
  <!-- xUnit é o único framework de teste do projeto. NUnit foi removido: o csproj
       carregava os dois runners ao mesmo tempo (8 arquivos xUnit + 2 NUnit), o que
       é frágil e contradizia o padrão declarado pelos agentes. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>
