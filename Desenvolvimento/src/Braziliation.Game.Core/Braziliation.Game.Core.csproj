<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Braziliation</RootNamespace>
    <!-- Copia DLLs de dependências NuGet para a saída de build para que o alvo de pós-build possa implantá-las no Unity -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <!--
    Após cada build, sincroniza a DLL do plugin e suas dependências NuGet que NÃO
    são fornecidas pelo runtime .NET 6 (CoreCLR) do Unity 6 para a pasta de Plugins do Unity.

    Excluídas (já presentes no BCL do Unity 6 .NET 6):
      System.Memory, System.Buffers, System.Numerics.Vectors,
      System.Threading.Tasks.Extensions

    Incluídas (ausentes no caminho de script do Unity 6 ou que exigem versão mais nova):
      System.Text.Json           � Unity 6 possui v6.0.0; o plugin precisa de v8.0.0
      System.Text.Encodings.Web  � dependência direta de System.Text.Json 8.x
      System.Runtime.CompilerServices.Unsafe � exigida por Encodings.Web 8.x
      Microsoft.Bcl.AsyncInterfaces � ausente no Mono; necessária para iteradores assíncronos
  -->
  <Target Name="CopyToUnityPlugins" AfterTargets="Build">
    <ItemGroup>
      <_PluginDlls Include="$(OutputPath)Braziliation.Game.Core.dll" />
      <_PluginDlls Include="$(OutputPath)System.Text.Json.dll" />
      <_PluginDlls Include="$(OutputPath)System.Text.Encodings.Web.dll" />
      <_PluginDlls Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
      <_PluginDlls Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDlls)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\..\Assets\Plugins\Braziliation\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
