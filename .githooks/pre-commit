#!/bin/sh
# Pre-commit do Braziliation — roda as travas locais antes de cada commit.
#
# Ativar uma vez por clone:   git config core.hooksPath .githooks
# Pular só em emergência:      git commit --no-verify   (e diga por quê na mensagem)
#
# Por que existe: em 2026-09 um .gitignore desancorado escondeu 8 arquivos de código e
# o commit publicado não compilava. Os testes que pegariam isso só rodavam no CI,
# depois do push. Aqui eles rodam antes do commit — para qualquer autor, humano ou agente.

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$STAGED" ] && exit 0

if command -v py >/dev/null 2>&1; then PY=py
elif command -v python3 >/dev/null 2>&1; then PY=python3
else PY=python; fi

# git-dir e não "$ROOT/.git": num worktree (as execuções da Central, ADR-012) `.git` é arquivo.
LOG="$(git rev-parse --absolute-git-dir)/pre-commit.log"
FALHOU=0

# 1. Testes .NET — cobrem o core e as guardas do repositório (.gitignore, docs,
#    paridade de agentes, CI, consistência de assets Unity). Rodam sempre: ~10 s.
echo "[pre-commit] dotnet test..."
# CI=true desliga o CopyToUnityPlugins: a trava não precisa reimplantar a DLL no Unity
# para rodar os testes, e não deve mexer em arquivo nenhum enquanto o commit é montado.
# (A pasta Assets/Plugins/Braziliation/ deixou de ser versionada em 2026-09-19; antes
# disso, sem este CI=true, cada commit deixava a DLL do core modificada.)
if CI=true dotnet test Desenvolvimento/Tests/Braziliation.Game.Tests/Braziliation.Game.Tests.csproj --nologo -v quiet >"$LOG" 2>&1; then
  grep -E "Aprovado!|Passed!" "$LOG" | tail -1
else
  echo "[pre-commit] FALHOU: dotnet test"
  grep -E "error |Com falha|Failed |\[FAIL\]|Assert" "$LOG" | head -25
  FALHOU=1
fi

# 2. Gates de repositório (pares asset/.meta, paletas) — rodados contra o ÍNDICE, não
#    contra o disco. Por quê: até 2026-09-19 o meta-check olhava a árvore de trabalho e
#    passava enquanto o CI reprovava o mesmo commit. Duas pastas de arte ficaram vazias
#    com os .meta ainda versionados; git não versiona pasta vazia, então em checkout
#    limpo o .meta virava órfão. Seis dias de CI vermelho, e esta trava não tinha como
#    perceber — na máquina de quem commita as pastas existem.
GATES=""
if echo "$STAGED" | grep -q '^Desenvolvimento/Assets/'; then
  GATES="meta"
fi
if echo "$STAGED" | grep -qE '^Desenvolvimento/Assets/Art/.*\.png$|^Design/ArteConceitual/Paletas/'; then
  GATES="${GATES:+$GATES,}paletas"
fi
if [ -n "$GATES" ]; then
  echo "[pre-commit] checkout limpo ($GATES)..."
  if ! $PY .claude/skills/meta-check/check_clean_checkout.py --gates "$GATES" >"$LOG" 2>&1; then
    tail -30 "$LOG"; FALHOU=1
  fi
fi

# 2b. Script Unity no commit — exige unity-validar OK e posterior à última edição.
#     Lê o resultado já gravado pela skill; não abre o Unity.
UNITY_CS=$(git diff --cached --name-only --diff-filter=ACMR | grep '^Desenvolvimento/Assets/.*\.cs$')
if [ -n "$UNITY_CS" ]; then
  echo "[pre-commit] unity-validar..."
  if ! echo "$UNITY_CS" | $PY .claude/skills/unity-validar/scripts/check_state.py >"$LOG" 2>&1; then
    cat "$LOG"; FALHOU=1
  fi
fi

# 3. TODOs de camada — parser único (ADR-012). Lê a versão em stage; leva menos de 1 s.
#    Por quê: em 2026-11-03 uma citação no meio da tabela de Lendas escondia dois itens Alta
#    de um dos leitores, e três ✅ seguiam no TODO de Desenvolvimento. Ninguém via.
echo "[pre-commit] todo.py validar..."
if ! $PY .claude/skills/gerir-todo/todo.py validar --indice >"$LOG" 2>&1; then
  cat "$LOG"; FALHOU=1
fi
if echo "$STAGED" | grep -qE '^\.claude/skills/gerir-todo/|^\.claude/hooks/session_snapshot\.py$'; then
  echo "[pre-commit] testes do parser de TODO..."
  if ! $PY -m unittest discover -s .claude/skills/gerir-todo/tests >"$LOG" 2>&1; then
    tail -30 "$LOG"; FALHOU=1
  fi
fi

# 4. Central (ADR-012) — testes no venv dela. Num worktree de execução da Central o venv não
#    existe; o do checkout principal serve, porque o código testado é o desta árvore.
if echo "$STAGED" | grep -q '^Central/'; then
  VENV_PY=""
  PRINCIPAL=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  for base in "$ROOT" "$PRINCIPAL"; do
    for py in "$base/Central/.venv/Scripts/python.exe" "$base/Central/.venv/bin/python"; do
      [ -z "$VENV_PY" ] && [ -x "$py" ] && VENV_PY="$py"
    done
  done
  if [ -z "$VENV_PY" ]; then
    echo "[pre-commit] AVISO: Central/.venv não existe — testes da Central não rodaram (ver Central/README.md)"
  else
    echo "[pre-commit] testes da Central..."
    if ! (cd Central && "$VENV_PY" -m unittest discover -s tests -t . >"$LOG" 2>&1); then
      tail -30 "$LOG"; FALHOU=1
    fi
  fi
fi

if [ "$FALHOU" -ne 0 ]; then
  echo "[pre-commit] Commit bloqueado. Log completo: $LOG"
  exit 1
fi
exit 0
